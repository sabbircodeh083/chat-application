<%- include('./partials/header.ejs'); %>
    <div class="manageUser-container">
      <div id="title">
        <h2>Manage Users</h2>
      </div>

      <div class="new-message-container new-user">
        <a
          href="#"
          onclick="openUserModal(event)"
          aria-haspopup="dialog"
          aria-controls="add-user-modal"
          aria-label="Create new user"
          >+</a
        >
      </div>

      <div id="users-table">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Manage</th>
            </tr>
          </thead>
          <tbody id="users-table">
            <% users.forEach(user=>{ %>
            <tr id="<%= user._id %>">
              <td class="name">
                <% if(user.avatar){ %>
                <img src="./uploads/avatars/<%= user.avatar %>" />
                <%}else{ %>
                <img src="./images/nophoto.png" />
                <% }%>
                <span><%=user.name %></span>
              </td>
              <td><%=user.email %></td>
              <td class="manage">
                <img src="./images/trash.png" alt="Delete" onclick="deleteUser('<%= user._id%>')" />
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <%- include('./partials/add-user-modal.ejs', {
      modalTitle: 'Create New User',
      submitLabel: 'Submit',
      formAction: '/users',
      successText: 'User was added successfully! Reloading the list...'
    }) %>
    <script>
       const deleteToast=Toastify({
        text:"User is deleted Successfully",
        duration:3000
       });

       const deleteErrorToast=Toastify({
        text:"could not delete the user",
        duration:3000
       });

       async  function deleteUser(_id){
        const response= await fetch(`/users/${_id}`,{
          method:"DELETE",
        });

        const result= await response.json();

        if( Object.keys(result.errors).length>0){
          deleteErrorToast.showToast();
        }else{
          deleteToast.showToast();
          document.getElementById(_id).remove();
        }
       }
    </script>
  </body>
</html>