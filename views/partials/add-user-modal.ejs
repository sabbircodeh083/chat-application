<div class="modal-wrapper" id="add-user-modal">
  <div class="modal">
    <a href="#" onclick="closeModal()" class="modal-close">+</a>
    <div class="modal-title">
      <h2>Create New User</h2>
    </div>
    <div class="modal-body">
      <form
        method="post"
        action="/users"
        enctype="multipart/form-data"
        id="add-user-form"
      >
        <input type="text" placeholder="enter name" name="name" />
        <p class="error name-error"></p>
        <input type="text" placeholder="enter email" name="email" />
        <p class="error email-error"></p>
        <input type="text" placeholder="enter mobile" name="mobile" />
        <p class="error mobile-error"></p>
        <input type="password" placeholder="enter password" name="password" />
        <p class="error password-error"></p>
        <input
          type="file"
          name="avatar"
          accept="image/png,image/jpeg,image/webp,image/gif"
        />
        <div class="avatar-selected" id="avatar-selected">
          <img id="avatar-preview-image" alt="Selected avatar" />
          <span id="avatar-preview-name"></span>
          <button
            type="button"
            id="avatar-remove"
            class="attachment-chip-remove"
            aria-label="Remove selected image"
          >
            &times;
          </button>
        </div>
        <p class="error avatar-error"></p>
        <input type="submit" value="Submit" />
        <p class="error common-error"></p>
      </form>
    </div>
  </div>
</div>
<script>
  //create success toast
  let successToast = Toastify({
    text: "User was added successfully! Reloading the list...",
    duration: 1000,
  });

  const modal = document.querySelector("#add-user-modal");
  function closeModal() {
    modal.style.display = "none";
  }
  function openModal() {
    modal.style.display = "block";
  }

  const form = document.querySelector("#add-user-form");

  // avatar selection preview + remove
  // keep these in sync with middlerwares/users/avatarupload.js
  const MAX_AVATAR_SIZE = 5 * 1024 * 1024; // 5 MB
  const ALLOWED_AVATAR_TYPES = [
    "image/jpeg",
    "image/jpg",
    "image/png",
    "image/webp",
    "image/gif",
  ];

  const avatarInput = form.querySelector('[name="avatar"]');
  const avatarSelected = document.querySelector("#avatar-selected");
  const avatarPreviewImage = document.querySelector("#avatar-preview-image");
  const avatarPreviewName = document.querySelector("#avatar-preview-name");
  const avatarError = document.querySelector(".avatar-error");
  let avatarObjectUrl = null;

  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + " B";
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
    return (bytes / (1024 * 1024)).toFixed(1) + " MB";
  }

  function renderAvatarPreview() {
    const file = avatarInput.files[0];

    if (avatarObjectUrl) {
      URL.revokeObjectURL(avatarObjectUrl);
      avatarObjectUrl = null;
    }

    if (!file) {
      avatarSelected.classList.remove("is-visible");
      avatarPreviewImage.removeAttribute("src");
      avatarPreviewName.textContent = "";
      return;
    }

    avatarObjectUrl = URL.createObjectURL(file);
    avatarPreviewImage.src = avatarObjectUrl;
    avatarPreviewName.textContent =
      file.name + " (" + formatFileSize(file.size) + ")";
    avatarSelected.classList.add("is-visible");
  }

  avatarInput.addEventListener("change", () => {
    avatarError.style.display = "none";
    avatarError.textContent = "";
    renderAvatarPreview();
  });

  document.querySelector("#avatar-remove").addEventListener("click", () => {
    avatarInput.value = "";
    avatarError.style.display = "none";
    avatarError.textContent = "";
    renderAvatarPreview();
  });

  function showAvatarError(message) {
    avatarError.textContent = message;
    avatarError.style.display = "block";
    avatarInput.classList.add("error");
  }

  form.onsubmit = async function (event) {
    event.preventDefault();

    const formData = new FormData(form);

    //set all error para hiddin
    const allErrorFields = document.querySelectorAll("p.error");
    allErrorFields.forEach((item) => {
      item.style.display = "none";
      item.textContent = "";
    });

    //remove error class form all input field
    const inputErrors = document.querySelectorAll("input.error");
    inputErrors.forEach((item) => {
      item.classList.remove("error");
    });

    const commonError = document.querySelector(".common-error");

    // validate the selected avatar before uploading
    const avatarFile = avatarInput.files[0];
    if (avatarFile) {
      if (!ALLOWED_AVATAR_TYPES.includes(avatarFile.type)) {
        showAvatarError(
          "Only .jpg, .jpeg, .png, .webp or .gif images are allowed!",
        );
        return;
      }
      if (avatarFile.size > MAX_AVATAR_SIZE) {
        showAvatarError(
          avatarFile.name +
            " is " +
            formatFileSize(avatarFile.size) +
            " - maximum size is " +
            formatFileSize(MAX_AVATAR_SIZE),
        );
        return;
      }
    }

    try {
      //send the request to the server
      const response = await fetch("./users", {
        method: "POST",
        body: formData,
      });

      //get response
      const result = await response.json().catch(() => null);

      if (!result || !result.errors) {
        throw new Error("Invalid response from server");
      }

      //find the error fileds
      const erorrFileds = Object.keys(result.errors);

      // handle the error fields
      if (erorrFileds.length > 0) {
        erorrFileds.forEach((fieldName) => {
          //add errro class for input filed
          const input = form.elements[fieldName];
          if (input) input.classList.add("error");

          //show the error message for each input field
          const errorPlaceholder = document.querySelector(
            `.${fieldName}-error`,
          );
          if (errorPlaceholder) {
            errorPlaceholder.textContent = result.errors[fieldName].msg;
            errorPlaceholder.style.display = "block";
          } else {
            commonError.textContent = result.errors[fieldName].msg;
            commonError.style.display = "block";
          }
        });
      } else {
        closeModal();
        form.reset();
        renderAvatarPreview();
        successToast.showToast();

        setTimeout(() => {
          location.reload();
        }, 1000);
      }
    } catch (err) {
      commonError.textContent = "Something went wrong. Please try again.";
      commonError.style.display = "block";
    }
  };
</script>
