<%
  // The partial is shared by the login page (register) and the users page
  // (admin creates a user). Both callers pass these values explicitly.

  const modalHeading = typeof modalTitle !== "undefined"
    ? modalTitle
    : "Create New User";
  const modalAction = typeof formAction !== "undefined"
    ? formAction
    : "/users";
  const modalSubmitLabel = typeof submitLabel !== "undefined"
    ? submitLabel
    : "Submit";
  const modalSuccessText = typeof successText !== "undefined"
    ? successText
    : "User was added successfully! Reloading the list...";
%>
<div
  class="modal-wrapper"
  id="add-user-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="add-user-modal-title"
>
  <div class="modal">
    <button
      type="button"
      onclick="closeUserModal(event)"
      class="modal-close"
      aria-label="Close dialog"
    >
      &times;
    </button>
    <div class="modal-title">
      <h2 id="add-user-modal-title"><%= modalHeading %></h2>
      <p>
        Fill in the details below. Your password is hashed before it is stored.
      </p>
    </div>
    <div class="modal-body">
      <form
        method="post"
        action="<%= modalAction %>"
        enctype="multipart/form-data"
        id="add-user-form"
      >
        <label class="field-label" for="user-name">Name</label>
        <input
          id="user-name"
          type="text"
          placeholder="Full name"
          name="name"
          autocomplete="name"
        />
        <p class="error name-error"></p>

        <label class="field-label" for="user-email">Email</label>
        <input
          id="user-email"
          type="email"
          placeholder="you@example.com"
          name="email"
          autocomplete="email"
        />
        <p class="error email-error"></p>

        <label class="field-label" for="user-mobile">Mobile</label>
        <input
          id="user-mobile"
          type="text"
          placeholder="+8801700000000"
          name="mobile"
          autocomplete="tel"
        />
        <p class="error mobile-error"></p>

        <label class="field-label" for="user-password">Password</label>
        <input
          id="user-password"
          type="password"
          placeholder="At least 8 characters, 1 upper, 1 symbol"
          name="password"
          autocomplete="new-password"
        />
        <p class="error password-error"></p>

        <span class="field-label">Profile photo (optional)</span>
        <label class="avatar-upload" for="user-avatar">
          <span class="avatar-upload-icon" aria-hidden="true">+</span>
          <span class="avatar-upload-text">
            <strong>Choose an image</strong>
            <small>JPG, PNG, WebP or GIF · max 5 MB</small>
          </span>
          <input
            id="user-avatar"
            type="file"
            name="avatar"
            class="visually-hidden"
            accept="image/png,image/jpeg,image/webp,image/gif"
          />
        </label>

        <div class="avatar-selected" id="avatar-selected">
          <img id="avatar-preview-image" alt="Selected avatar" />
          <span id="avatar-preview-name"></span>
          <button
            type="button"
            id="avatar-remove"
            class="attachment-chip-remove"
            aria-label="Remove selected image"
          >
            &times;
          </button>
        </div>
        <p class="error avatar-error"></p>

        <input type="submit" value="<%= modalSubmitLabel %>" />
        <p class="error common-error"></p>
      </form>
    </div>
  </div>
</div>
<script>
  //create success toast
  let successToast = Toastify({
    text: <%- JSON.stringify(modalSuccessText) %>,
    duration: 1500,
  });

  const userModal = document.querySelector("#add-user-modal");
  const addUserForm = document.querySelector("#add-user-form");

  function closeUserModal(event) {
    if (event) event.preventDefault();
    userModal.style.display = "none";
    document.body.style.overflow = "";
  }

  function openUserModal(event) {
    if (event) event.preventDefault();
    userModal.style.display = "flex";
    document.body.style.overflow = "hidden";
    setTimeout(() => addUserForm.elements.name?.focus(), 50);
  }

  // close when clicking the dimmed backdrop or pressing Escape
  userModal.addEventListener("click", (event) => {
    if (event.target === userModal) {
      closeUserModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && userModal.style.display === "flex") {
      closeUserModal();
    }
  });

  const form = addUserForm;

  // avatar selection preview + remove
  // keep these in sync with middlerwares/users/avatarupload.js
  const MAX_AVATAR_SIZE = 5 * 1024 * 1024; // 5 MB
  const ALLOWED_AVATAR_TYPES = [
    "image/jpeg",
    "image/jpg",
    "image/png",
    "image/webp",
    "image/gif",
  ];

  const avatarInput = form.querySelector('[name="avatar"]');
  const avatarSelected = document.querySelector("#avatar-selected");
  const avatarPreviewImage = document.querySelector("#avatar-preview-image");
  const avatarPreviewName = document.querySelector("#avatar-preview-name");
  const avatarError = document.querySelector(".avatar-error");
  let avatarObjectUrl = null;

  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + " B";
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
    return (bytes / (1024 * 1024)).toFixed(1) + " MB";
  }

  function renderAvatarPreview() {
    const file = avatarInput.files[0];

    if (avatarObjectUrl) {
      URL.revokeObjectURL(avatarObjectUrl);
      avatarObjectUrl = null;
    }

    if (!file) {
      avatarSelected.classList.remove("is-visible");
      avatarPreviewImage.removeAttribute("src");
      avatarPreviewName.textContent = "";
      return;
    }

    avatarObjectUrl = URL.createObjectURL(file);
    avatarPreviewImage.src = avatarObjectUrl;
    avatarPreviewName.textContent =
      file.name + " (" + formatFileSize(file.size) + ")";
    avatarSelected.classList.add("is-visible");
  }

  avatarInput.addEventListener("change", () => {
    avatarError.style.display = "none";
    avatarError.textContent = "";
    renderAvatarPreview();
  });

  document.querySelector("#avatar-remove").addEventListener("click", () => {
    avatarInput.value = "";
    avatarError.style.display = "none";
    avatarError.textContent = "";
    renderAvatarPreview();
  });

  function showAvatarError(message) {
    avatarError.textContent = message;
    avatarError.style.display = "block";
    avatarInput.classList.add("error");
  }

  form.onsubmit = async function (event) {
    event.preventDefault();

    const formData = new FormData(form);

    //set all error para hiddin
    const allErrorFields = form.querySelectorAll("p.error");
    allErrorFields.forEach((item) => {
      item.style.display = "none";
      item.textContent = "";
    });

    //remove error class form all input field
    const inputErrors = form.querySelectorAll("input.error");
    inputErrors.forEach((item) => {
      item.classList.remove("error");
    });

    const commonError = form.querySelector(".common-error");

    // validate the selected avatar before uploading
    const avatarFile = avatarInput.files[0];
    if (avatarFile) {
      if (!ALLOWED_AVATAR_TYPES.includes(avatarFile.type)) {
        showAvatarError(
          "Only .jpg, .jpeg, .png, .webp or .gif images are allowed!",
        );
        return;
      }
      if (avatarFile.size > MAX_AVATAR_SIZE) {
        showAvatarError(
          avatarFile.name +
            " is " +
            formatFileSize(avatarFile.size) +
            " - maximum size is " +
            formatFileSize(MAX_AVATAR_SIZE),
        );
        return;
      }
    }

    try {
      //send the request to the server
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
      });

      //get response
      const result = await response.json().catch(() => null);

      if (!result || !result.errors) {
        throw new Error("Invalid response from server");
      }

      //find the error fileds
      const erorrFileds = Object.keys(result.errors);

      // handle the error fields
      if (erorrFileds.length > 0) {
        erorrFileds.forEach((fieldName) => {
          //add errro class for input filed
          const input = form.elements[fieldName];
          if (input) input.classList.add("error");

          //show the error message for each input field
          const errorPlaceholder = form.querySelector(
            `.${fieldName}-error`,
          );
          if (errorPlaceholder) {
            errorPlaceholder.textContent = result.errors[fieldName].msg;
            errorPlaceholder.style.display = "block";
          } else {
            commonError.textContent = result.errors[fieldName].msg;
            commonError.style.display = "block";
          }
        });
      } else {
        closeUserModal();
        form.reset();
        renderAvatarPreview();
        successToast.showToast();

        setTimeout(() => {
          location.reload();
        }, 900);
      }
    } catch (err) {
      commonError.textContent = "Something went wrong. Please try again.";
      commonError.style.display = "block";
    }
  };
</script>
