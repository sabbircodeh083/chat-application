<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Sumit Saha" />
    <meta name="owner" content="learnwithsumit.com" />
    <title><%= title %></title>
    <!-- root-absolute paths: relative ones break (404) whenever the page URL
         has a trailing slash or an extra path segment -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/stylesheets/toastify.css" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="/js/toastify.js"></script>
    <script src="/js/moment.js"></script>
  </head>
  <body>
    <div class="menu">
      <% if(loggedInUser && loggedInUser.username){ %>
      <!-- logged in user, pinned to the left of the menu bar -->
      <div class="menu-user">
        <% const avatarSrc = loggedInUser.avatar
          ? `/uploads/avatars/${loggedInUser.avatar}`
          : '/images/nophoto.png'; %>
        <img src="<%= avatarSrc %>" alt="<%= loggedInUser.username %>" onerror="this.src='/images/nophoto.png'" />
        <span><%= loggedInUser.username %></span>
      </div>
      <% } %>
      <% if(loggedInUser && loggedInUser.username){ %>
      <div class="menu-item"><a href="/inbox">Inbox</a></div>
      <div class="menu-item"><a href="/users">Users</a></div>
      <div class="menu-item"><a href="#" onclick="logoutRequest(event)" >Logout</a></div>
        <%}else{%>
      <div class="menu-item"><a href="/inbox">Inbox</a></div>
      <div class="menu-item"><a href="/users">Users</a></div>
      <div class="menu-item"><a href="/">Login</a></div>
      <%}%>
    </div>

    <Script> 
      const logoutToast=Toastify({
          text:"Logout successfull",
          duration:1000
        });
      async function logoutRequest(event){
        event.preventDefault();
        //create toast
        
        //send request
        await fetch("/",{
          method:"DELETE"
        });
        //show toast 
        logoutToast.showToast();

        setTimeout(() => {
          window.location.replace("/")
        }, 1000);
      }
    </Script>
    <!-- prettier-ignore -->
  
