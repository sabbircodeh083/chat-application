<%- include('./partials/header.ejs'); %>
    <div id="chat-container">
      <div id="search-container">
        <input
          type="text"
          id="conversation-search"
          placeholder="Search by name"
          autocomplete="off"
          aria-label="Search conversations by partner name"
        />
      </div>
      <div id="conversation-list">
        <div class="search-empty hide" id="search-empty" role="status">
          No conversation found
        </div>

        <% Cdata.forEach(conversation => { %>
          <!-- conversation creator is same to logged in user, so we need to show participant name and avatar -->
          <% if(conversation.creator.id == loggedInUser.userid) { %>
            <div class="conversation" onclick="getMessages('<%= conversation._id %>', '<%= conversation.participant.name %>')">
              <% if (conversation.participant.avatar) { %>
              <img src="./uploads/avatars/<%= conversation.participant.avatar %>" alt="<%= conversation.participant.name %>" />
              <% } else { %>
                <img src="./images/nophoto.png" alt="pI" />
              <% } %>
              <div class="title-text"><%= conversation.participant.name %></div>
              <div class="conversation-date"><%=conversation.last_updated%></div>
            </div>
          <% } else { %>
            <div class="conversation" onclick="getMessages('<%= conversation._id %>', '<%= conversation.creator.name %>')">
              <% if (conversation.creator.avatar) { %>
              <img src="./uploads/avatars/<%= conversation.creator.avatar %>" alt="<%= conversation.creator.name %>" />
              <% } else { %>
                <img src="./images/nophoto.png" />
              <% } %>
              <div class="title-text"><%= conversation.creator.name %></div>
              <div class="conversation-date"><%= conversation.last_updated%></div>
            </div>
          <% } %>
        <% }); %>
        
        <!-- show no conversation placeholder image for 0 conversations -->
        <% if(Cdata && Cdata.length === 0) { %>
          <div class="nothing"><img src="./images/no-conversation.svg"></div>
        <% } %>
      </div>

      <!-- open modal -->
      <div class="new-message-container" onclick="openModal()">
        <a href="#">+</a>
      </div>
      
      <div id="chat-title">
        <span id="conversation-partner"></span>
        <img src="./images/trash.png" alt="Delete Conversation" onclick="handleConversationDelete()" />
      </div>

      <!-- placeholder div if no messages are in messages area -->
      <div id="chat-message-list">
        <div class="nothing" id="empty-chatbox">select a conversation</div>
      </div>

      <!-- send message form -->
      <form id="chat-form" method="post" enctype="multipart/form-data">
        <label for="attachment"><img src="./images/attachment.png" alt="Add Attachment" /></label>
        <input
          type="file"
          multiple
          name="attachment"
          class="hide"
          id="attachment"
          accept="image/png,image/jpeg,image/webp,image/gif"
        />
        <input type="text" name="message" placeholder="Type a message" autocomplete="off" />
        <button type="submit" id="send-button" class="send-button" aria-label="Send message">&#10148;</button>
        <div class="chat-form-overlay">
          <div id="attachment-preview" class="attachment-preview"></div>
          <p id="chat-error" class="chat-error" role="alert"></p>
        </div>
      </form>
    </div>

    <%- include('./partials/add-conversation-modal.ejs')%>

       <!-- socket.io client served by our own server (version always matches) -->
    <script src="/socket.io/socket.io.js"></script>

    <script>
    const form = document.querySelector('#chat-form');
    const messageContainer = document.querySelector('#chat-message-list');
    const chatTitleContainer = document.querySelector('#conversation-partner');
    const loggedinUserId = '<%= loggedInUser.userid %>';
    const loggedinUserName = '<%= loggedInUser.username %>';
    let participant = null; // selected conversation participant object
    let current_conversation_id; // selected conversation id

    // conversation search: filter the server-rendered conversation list (Cdata)
    // by the partner name shown in each row.
    const searchInput = document.querySelector('#conversation-search');
    const conversationList = document.querySelector('#conversation-list');
    const searchEmpty = document.querySelector('#search-empty');

    async function handleConversationDelete(){
      const conversationDeleteFailureToast= Toastify({
        text:"Error delete Conversation",
        duration:1000,
      }); 

      const conversationDeleteSuccessToast= Toastify({
        text:"Successfull Conversation deletion",
        duration:1000,
      }); 

      const res=await fetch(`/inbox/conversation/${current_conversation_id}`,{
        method:"DELETE",
      });
      const result = await res;
      
      if(!result.errors){
        conversationDeleteSuccessToast.showToast();
        location.reload();
      }else{
        conversationDeleteFailureToast.showToast();
      }

    }

    function filterConversations() {
      const query = searchInput.value.trim().toLowerCase();
      const conversations = conversationList.querySelectorAll('.conversation');
      let visibleCount = 0;

      conversations.forEach((conversation) => {
        const nameElement = conversation.querySelector('.title-text');
        const partnerName = (nameElement?.textContent || '').trim().toLowerCase();
        const matches = partnerName.includes(query);

        conversation.classList.toggle('hide', !matches);
        if (matches) {
          visibleCount += 1;
        }
      });

      // only show the message when there are conversations but none match
      const hasConversations = conversations.length > 0;
      searchEmpty.classList.toggle(
        'hide',
        !hasConversations || visibleCount > 0,
      );
    }

    searchInput.addEventListener('input', filterConversations);
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        searchInput.value = '';
        filterConversations();
      }
    });


    // socket initialization (same origin as the page)
    const socket = io();

    // handle new/live incoming message from socket
      socket.on("new_message", data => {
        // ignore our own messages: sendMessage() reloads the conversation
        // from the server after a successful POST, so the message is already shown
        if (String(data.message.sender.id) === loggedinUserId) {
          return;
        }

        // only respond if current conversation is open in any client
        if(data.message.conversation_id == current_conversation_id) {
          // message class
          const messageClass = data.message.sender.id === loggedinUserId ? 'you-message' : 'other-message';
          
          const senderAvatar = data.message.sender.avatar ? `<img src="./uploads/avatars/${data.message.sender.avatar}" alt="${data.message.sender.name}" />` : `<img src="./images/nophoto.png" alt="${data.message.sender.name}" />`;

          // message attachments
          let attachments = '<div class="attachments">';

          if(data.message.attachment && data.message.attachment.length > 0) {
            data.message.attachment.forEach(attachment => {
              attachments += `<img src="./uploads/attachments/${attachment}" /> `;
            });
          }

          attachments += '</div>';

          let messageHTML;

          // do not show avatar for loggedin user
          if(data.message.sender.id == loggedinUserId) {
            messageHTML = `<div class="message-row ${messageClass}"><div class="message-content">
              <div class="message-text">${data.message.message}</div>
              ${attachments}
              <div class="message-time">${moment(data.message.date_time).fromNow()}</div>
            </div></div>`;
          } else {
            messageHTML = `<div class="message-row ${messageClass}"><div class="message-content">
              ${senderAvatar}
              <div class="message-text">${data.message.message}</div>
              ${attachments}
              <div class="message-time">${moment(data.message.date_time).fromNow()}</div>
            </div></div>`;
          }

          // append the incoming message to the message area as last item
          const emptyChatbox = messageContainer.querySelector('#empty-chatbox');
          if (emptyChatbox) {
            emptyChatbox.remove();
          }

          const firstMessage = messageContainer.querySelector('.message-row');
          if (firstMessage) {
            firstMessage.insertAdjacentHTML('beforeBegin', messageHTML);
          } else {
            messageContainer.insertAdjacentHTML('beforeend', messageHTML);
          }
        }
      });


    // attachment handling
    const attachmentInput = document.querySelector('#attachment');
    const attachmentPreview = document.querySelector('#attachment-preview');
    const chatError = document.querySelector('#chat-error');
    const sendButton = document.querySelector('#send-button');

    // keep in sync with middlerwares/inbox/attachmentUpload.js
    const MAX_ATTACHMENT_SIZE = 10 * 1024 * 1024; // 10 MB
    const MAX_ATTACHMENTS = 5;
    const ALLOWED_ATTACHMENT_TYPES = [
      'image/jpeg',
      'image/jpg',
      'image/png',
      'image/webp',
      'image/gif',
    ];

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function showChatError(message) {
      chatError.textContent = message;
      chatError.style.display = 'block';
    }

    function clearChatError() {
      chatError.textContent = '';
      chatError.style.display = 'none';
    }

    // replace the file selection (used when removing one file at a time)
    function setAttachmentFiles(files) {
      const transfer = new DataTransfer();
      files.forEach((file) => transfer.items.add(file));
      attachmentInput.files = transfer.files;
    }

    function removeAttachment(index) {
      const files = Array.from(attachmentInput.files);
      files.splice(index, 1);
      if (files.length > 0) {
        setAttachmentFiles(files);
      } else {
        attachmentInput.value = '';
      }
      renderAttachmentPreview();
    }

    function clearAttachments() {
      attachmentInput.value = '';
      renderAttachmentPreview();
    }

    function renderAttachmentPreview() {
      const files = Array.from(attachmentInput.files);
      attachmentPreview.innerHTML = '';

      if (files.length === 0) {
        attachmentPreview.classList.remove('is-visible');
        return;
      }

      files.forEach((file, index) => {
        const chip = document.createElement('div');
        chip.className = 'attachment-chip';

        if (file.type.startsWith('image/')) {
          const thumb = document.createElement('img');
          const objectUrl = URL.createObjectURL(file);
          thumb.src = objectUrl;
          thumb.onload = () => URL.revokeObjectURL(objectUrl);
          chip.appendChild(thumb);
        }

        const name = document.createElement('span');
        name.className = 'attachment-chip-name';
        name.textContent = file.name;

        const size = document.createElement('span');
        size.className = 'attachment-chip-size';
        size.textContent = formatFileSize(file.size);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'attachment-chip-remove';
        remove.textContent = '\u00d7';
        remove.setAttribute('aria-label', 'Remove ' + file.name);
        remove.addEventListener('click', () => removeAttachment(index));

        chip.append(name, size, remove);
        attachmentPreview.appendChild(chip);
      });

      if (files.length > 1) {
        const clearAll = document.createElement('button');
        clearAll.type = 'button';
        clearAll.className = 'attachment-clear-all';
        clearAll.textContent = 'Clear all';
        clearAll.addEventListener('click', clearAttachments);
        attachmentPreview.appendChild(clearAll);
      }

      attachmentPreview.classList.add('is-visible');
    }

    attachmentInput.addEventListener('change', () => {
      clearChatError();
      renderAttachmentPreview();
    });



    // renders the placeholder shown when a conversation has no messages.
    // it rebuilds the element every time, so it never depends on a node that
    // a previous render may have removed from the DOM.
    function renderEmptyState(text) {
      const empty = document.createElement('div');
      empty.className = 'nothing';
      empty.id = 'empty-chatbox';
      empty.textContent = text;
      messageContainer.replaceChildren(empty);
    }

    function buildMessageHTML(message) {
      const isMine = String(message.sender.id) === loggedinUserId;
      const messageClass = isMine ? 'you-message' : 'other-message';
      const senderAvatar = message.sender.avatar
        ? `./uploads/avatars/${message.sender.avatar}`
        : './images/nophoto.png';
      const showAvatar = isMine
        ? ''
        : `<img src="${senderAvatar}" alt="${message.sender.name}" />`;

      let attachments = "<div class='attachments'>";

      if (message.attachment && message.attachment.length > 0) {
        message.attachment.forEach((item) => {
          attachments += `<img src="./uploads/attachments/${item}" /> `;
        });
      }
      attachments += '</div>';

      return `<div class="message-row ${messageClass}"><div class="message-content">
              ${showAvatar}
              <div class="message-text">${message.text}</div>
              ${attachments}
              <div class="message-time">${moment(message.date_time).fromNow()}</div>
            </div></div>`;
    }

    // incremented on every conversation switch so a slow response for an older
    // click cannot overwrite the conversation the user is looking at now
    let messagesRequestId = 0;

    async function getMessages(conversationId, partnerName){
      const messagesFailureToast = Toastify({
        text: "Error Loading message",
        duration: 1000,
      });

      const requestId = ++messagesRequestId;

      try {
        const res = await fetch(`/inbox/messages/${conversationId}`);
        const result = await res.json();

        // a newer conversation was selected while this request was in flight
        if (requestId !== messagesRequestId) {
          return;
        }

        if (result.errors || !result.data) {
          messagesFailureToast.showToast();
          return;
        }

        const { data } = result;

        participant = data.participant;
        current_conversation_id = conversationId;
        chatTitleContainer.textContent = partnerName;
        form.style.visibility = "visible";

        const messages = Array.isArray(data.messages) ? data.messages : [];

        if (messages.length === 0) {
          renderEmptyState(`Say hi to ${partnerName}`);
        } else {
          // build once instead of rewriting innerHTML for every message
          messageContainer.innerHTML = messages.map(buildMessageHTML).join('');
        }
      } catch (err) {
        if (requestId === messagesRequestId) {
          messagesFailureToast.showToast();
        }
      }
    }

    form.onsubmit= async function(event){
      event.preventDefault();

      clearChatError();

      const messageInput = form.querySelector('[name="message"]');
      const files = Array.from(attachmentInput.files);

      // nothing to send
      if (!messageInput.value.trim() && files.length === 0) {
        return;
      }

      // a conversation has to be selected first
      if (!participant || !current_conversation_id) {
        showChatError("Please select a conversation first");
        return;
      }

      // validate the selected files before uploading
      if (files.length > MAX_ATTACHMENTS) {
        showChatError("Maximum " + MAX_ATTACHMENTS + " files can be attached at a time");
        return;
      }

      const invalidType = files.find(
        (file) => !ALLOWED_ATTACHMENT_TYPES.includes(file.type),
      );
      if (invalidType) {
        showChatError(
          invalidType.name +
            ": only .jpg, .jpeg, .png, .webp or .gif images are allowed",
        );
        return;
      }

      const tooLarge = files.find((file) => file.size > MAX_ATTACHMENT_SIZE);
      if (tooLarge) {
        showChatError(
          tooLarge.name +
            " is " +
            formatFileSize(tooLarge.size) +
            " - maximum size per file is " +
            formatFileSize(MAX_ATTACHMENT_SIZE),
        );
        return;
      }

      // prepare the form data
      const formData = new FormData(form);
      formData.append('receiverId', participant.id);
      formData.append('receiverName', participant.name);
      formData.append('avatar', participant.avatar || '');
      formData.append('conversationId', current_conversation_id);

      sendButton.disabled = true;

      try {
        // send the request to server
        const response = await fetch("/inbox/message", {
          method: "POST",
          body: formData,
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result || result.errors) {
          // show the first server error, if there is one
          let errorMessage = "Could not send the message. Please try again.";
          if (result && result.errors) {
            const firstError = Object.values(result.errors)[0];
            errorMessage =
              typeof firstError === "string"
                ? firstError
                : firstError.msg || errorMessage;
          }
          showChatError(errorMessage);
          return;
        }

        // clear the form and reload the conversation so the new message shows up
        form.reset();
        renderAttachmentPreview();
        await getMessages(current_conversation_id, participant.name);
      } catch (err) {
        showChatError(
          "Could not send the message. Please check your connection and try again.",
        );
      } finally {
        sendButton.disabled = false;
      }
    }
  </script>
  </body>
  
</html>