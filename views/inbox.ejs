<%- include('./partials/header.ejs'); %>
    <div id="chat-container">
      <aside class="sidebar" aria-label="Conversations">
        <div id="search-container">
          <input
            type="text"
            id="conversation-search"
            placeholder="Search conversations"
            autocomplete="off"
            aria-label="Search conversations by partner name"
          />
        </div>

        <div class="sidebar-header">
          <div>
            <span class="sidebar-title">Messages</span>
            <span class="sidebar-count"
              ><%= Cdata.length %> conversation<%= Cdata.length === 1 ? "" : "s" %></span
            >
          </div>
          <button
            type="button"
            class="new-message-container"
            onclick="openModal()"
            aria-label="Start a new conversation"
            title="New conversation"
          >
            <span aria-hidden="true">+</span>
          </button>
        </div>

        <div id="conversation-list">
          <div class="search-empty hide" id="search-empty" role="status">
            No conversations found
          </div>

          <% Cdata.forEach(conversation => { %>
            <%
              // the logged-in user can be either side of the conversation
              const isCreator =
                String(conversation.creator.id) === String(loggedInUser.userid);
              const partner = isCreator
                ? conversation.participant
                : conversation.creator;
              const last = conversation.last_message;
              const updated =
                last && last.date_time
                  ? last.date_time
                  : conversation.last_update;
            %>
            <div
              class="conversation"
              role="button"
              tabindex="0"
              data-conversation-id="<%= conversation._id %>"
              data-partner-name="<%= partner.name %>"
              aria-label="Open conversation with <%= partner.name %>"
            >
              <img
                src="<%= partner.avatar ? `/uploads/avatars/${partner.avatar}` : '/images/nophoto.png' %>"
                alt=""
                onerror="this.src='/images/nophoto.png'"
              />
              <div class="title-text"><%= partner.name %></div>
              <% if (updated) { %>
                <time
                  class="conversation-date"
                  datetime="<%= new Date(updated).toISOString() %>"
                  data-relative
                  ><%= new Date(updated).toLocaleDateString() %></time
                >
              <% } else { %>
                <span class="conversation-date"></span>
              <% } %>
              <div class="conversation-preview">
                <% if (last) { %>
                  <% if (String(last.sender.id) === String(loggedInUser.userid)) { %><span class="preview-you">You: </span><% } %>
                  <%= last.text && last.text.trim() ? last.text : (last.attachment && last.attachment.length ? "Photo" : "Message") %>
                <% } else { %>
                  No messages yet — say hello
                <% } %>
              </div>
            </div>
          <% }); %>

          <!-- show no conversation placeholder image for 0 conversations -->
          <% if(Cdata && Cdata.length === 0) { %>
            <div class="nothing">
              <img src="/images/illustration.png" alt="" />
              <p>No conversations yet</p>
              <small>Tap + to start chatting with someone.</small>
            </div>
          <% } %>
        </div>
      </aside>

      <section class="chat-panel" aria-label="Conversation">
        <div id="chat-title">
          <button
            type="button"
            class="chat-back"
            id="chat-back"
            aria-label="Back to conversations"
          >
            &#8592;
          </button>
          <img
            id="chat-partner-avatar"
            class="chat-partner-avatar"
            src="/images/nophoto.png"
            alt=""
            onerror="this.src='/images/nophoto.png'"
          />
          <div class="chat-title-text">
            <span id="conversation-partner">Select a conversation</span>
            <span class="chat-status"
              >Choose someone from your inbox to start chatting</span
            >
          </div>
          <button
            type="button"
            class="icon-button"
            id="delete-conversation"
            onclick="handleConversationDelete()"
            aria-label="Delete conversation"
            title="Delete conversation"
            disabled
          >
            <img src="/images/trash.png" alt="" />
          </button>
        </div>

        <!-- placeholder div if no messages are in messages area -->
        <div id="chat-message-list">
          <div class="nothing" id="empty-chatbox">
            <img src="/images/illustration.png" alt="" />
            <p>Select a conversation to start chatting</p>
            <small>Your messages will appear here.</small>
          </div>
        </div>

        <!-- send message form -->
        <form id="chat-form" method="post" enctype="multipart/form-data">
          <label for="attachment" class="attach-button" title="Attach images">
            <img src="/images/attachment.png" alt="Attach images" />
            <input
              type="file"
              multiple
              name="attachment"
              class="visually-hidden"
              id="attachment"
              accept="image/png,image/jpeg,image/webp,image/gif"
            />
          </label>
          <input
            type="text"
            name="message"
            placeholder="Write a message..."
            autocomplete="off"
            aria-label="Message"
          />
          <button
            type="submit"
            id="send-button"
            class="send-button"
            aria-label="Send message"
          >
            &#10148;
          </button>
          <div class="chat-form-overlay">
            <div id="attachment-preview" class="attachment-preview"></div>
            <p id="chat-error" class="chat-error" role="alert"></p>
          </div>
        </form>
      </section>
    </div>

    <%- include('./partials/add-conversation-modal.ejs')%>

       <!-- socket.io client served by our own server (version always matches) -->
    <script src="/socket.io/socket.io.js"></script>

    <script>
    const form = document.querySelector('#chat-form');
    const messageContainer = document.querySelector('#chat-message-list');
    const chatContainer = document.querySelector('#chat-container');
    const chatTitleContainer = document.querySelector('#conversation-partner');
    const chatStatus = document.querySelector('.chat-status');
    const chatPartnerAvatar = document.querySelector('#chat-partner-avatar');
    const deleteConversationButton = document.querySelector('#delete-conversation');
    const backButton = document.querySelector('#chat-back');
    const loggedinUserId = '<%= String(loggedInUser.userid) %>';
    const loggedinUserName = '<%= loggedInUser.username %>';
    let participant = null; // selected conversation participant object
    let current_conversation_id; // selected conversation id

    // conversation search: filter the server-rendered conversation list (Cdata)
    // by the partner name shown in each row.
    const searchInput = document.querySelector('#conversation-search');
    const conversationList = document.querySelector('#conversation-list');
    const searchEmpty = document.querySelector('#search-empty');

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[char]));
    }

    async function handleConversationDelete() {
      if (!current_conversation_id) {
        return;
      }

      const confirmed = confirm(
        'Delete this conversation and all of its messages? This cannot be undone.',
      );
      if (!confirmed) {
        return;
      }

      const conversationDeleteFailureToast = Toastify({
        text: 'Could not delete the conversation',
        duration: 1800,
      });

      const conversationDeleteSuccessToast = Toastify({
        text: 'Conversation deleted',
        duration: 1500,
      });

      try {
        const response = await fetch(
          `/inbox/conversation/${current_conversation_id}`,
          { method: 'DELETE' },
        );
        const result = await response.json().catch(() => null);

        if (!response.ok || !result || result.errors) {
          conversationDeleteFailureToast.showToast();
          return;
        }

        conversationDeleteSuccessToast.showToast();
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        conversationDeleteFailureToast.showToast();
      }
    }

    function filterConversations() {
      const query = searchInput.value.trim().toLowerCase();
      const conversations = conversationList.querySelectorAll('.conversation');
      let visibleCount = 0;

      conversations.forEach((conversation) => {
        const nameElement = conversation.querySelector('.title-text');
        const partnerName = (nameElement?.textContent || '').trim().toLowerCase();
        const matches = partnerName.includes(query);

        conversation.classList.toggle('hide', !matches);
        if (matches) {
          visibleCount += 1;
        }
      });

      // only show the message when there are conversations but none match
      const hasConversations = conversations.length > 0;
      searchEmpty.classList.toggle(
        'hide',
        !hasConversations || visibleCount > 0,
      );
    }

    searchInput.addEventListener('input', filterConversations);
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        searchInput.value = '';
        filterConversations();
      }
    });

    // open a conversation from the server-rendered sidebar
    conversationList.querySelectorAll('.conversation').forEach((row) => {
      const openConversation = () =>
        getMessages(
          row.dataset.conversationId,
          row.dataset.partnerName,
          row,
        );

      row.addEventListener('click', openConversation);
      row.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openConversation();
        }
      });
    });

    // mobile: return from the chat pane to the conversation list
    backButton.addEventListener('click', () => {
      chatContainer.classList.remove('chat-open');
    });


    // socket initialization (same origin as the page)
    const socket = io();

    // keep the sidebar preview and timestamp in sync with live messages
    function updateConversationRow(message) {
      const row = conversationList.querySelector(
        `.conversation[data-conversation-id="${message.conversation_id}"]`,
      );

      if (!row) {
        return;
      }

      const preview = row.querySelector('.conversation-preview');
      if (preview) {
        preview.textContent = '';

        if (String(message.sender.id) === loggedinUserId) {
          const you = document.createElement('span');
          you.className = 'preview-you';
          you.textContent = 'You: ';
          preview.appendChild(you);
        }

        const previewText =
          message.message && message.message.trim()
            ? message.message
            : message.attachment && message.attachment.length
              ? 'Photo'
              : 'Message';
        preview.appendChild(document.createTextNode(previewText));
      }

      const date = row.querySelector('.conversation-date');
      if (date && message.date_time) {
        date.dateTime = message.date_time;
        date.textContent = moment(message.date_time).fromNow();
      }

      // newest conversation first
      conversationList.prepend(row);
    }

    // handle new/live incoming message from socket
    socket.on('new_message', (data) => {
      const message = data.message;

      updateConversationRow(message);

      // ignore our own messages: sendMessage() reloads the conversation
      // from the server after a successful POST, so the message is already shown
      if (String(message.sender.id) === loggedinUserId) {
        return;
      }

      // only append if the matching conversation is currently open
      if (String(message.conversation_id) !== String(current_conversation_id)) {
        return;
      }

      const senderName = escapeHtml(message.sender.name);
      const senderAvatar = message.sender.avatar
        ? `<img src="/uploads/avatars/${escapeHtml(message.sender.avatar)}" alt="${senderName}" />`
        : `<img src="/images/nophoto.png" alt="${senderName}" />`;

      let attachments = '<div class="attachments">';
      if (message.attachment && message.attachment.length > 0) {
        message.attachment.forEach((attachment) => {
          attachments += `<img src="/uploads/attachments/${escapeHtml(attachment)}" alt="Attachment" loading="lazy" />`;
        });
      }
      attachments += '</div>';

      const messageHTML = `<div class="message-row other-message">
        <div class="message-content">
          ${senderAvatar}
          <div class="message-body">
            <div class="message-text">${escapeHtml(message.message)}</div>
            ${attachments}
            <div class="message-time">${moment(message.date_time).fromNow()}</div>
          </div>
        </div>
      </div>`;

      // column-reverse list: insert before the first (newest) row to append at
      // the visual bottom
      const emptyChatbox = messageContainer.querySelector('#empty-chatbox');
      if (emptyChatbox) {
        emptyChatbox.remove();
      }

      const firstMessage = messageContainer.querySelector('.message-row');
      if (firstMessage) {
        firstMessage.insertAdjacentHTML('beforeBegin', messageHTML);
      } else {
        messageContainer.insertAdjacentHTML('beforeend', messageHTML);
      }
    });


    // attachment handling
    const attachmentInput = document.querySelector('#attachment');
    const attachmentPreview = document.querySelector('#attachment-preview');
    const chatError = document.querySelector('#chat-error');
    const sendButton = document.querySelector('#send-button');

    // keep in sync with middlerwares/inbox/attachmentUpload.js
    const MAX_ATTACHMENT_SIZE = 10 * 1024 * 1024; // 10 MB
    const MAX_ATTACHMENTS = 5;
    const ALLOWED_ATTACHMENT_TYPES = [
      'image/jpeg',
      'image/jpg',
      'image/png',
      'image/webp',
      'image/gif',
    ];

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function showChatError(message) {
      chatError.textContent = message;
      chatError.style.display = 'block';
    }

    function clearChatError() {
      chatError.textContent = '';
      chatError.style.display = 'none';
    }

    // replace the file selection (used when removing one file at a time)
    function setAttachmentFiles(files) {
      const transfer = new DataTransfer();
      files.forEach((file) => transfer.items.add(file));
      attachmentInput.files = transfer.files;
    }

    function removeAttachment(index) {
      const files = Array.from(attachmentInput.files);
      files.splice(index, 1);
      if (files.length > 0) {
        setAttachmentFiles(files);
      } else {
        attachmentInput.value = '';
      }
      renderAttachmentPreview();
    }

    function clearAttachments() {
      attachmentInput.value = '';
      renderAttachmentPreview();
    }

    function renderAttachmentPreview() {
      const files = Array.from(attachmentInput.files);
      attachmentPreview.innerHTML = '';

      if (files.length === 0) {
        attachmentPreview.classList.remove('is-visible');
        return;
      }

      files.forEach((file, index) => {
        const chip = document.createElement('div');
        chip.className = 'attachment-chip';

        if (file.type.startsWith('image/')) {
          const thumb = document.createElement('img');
          const objectUrl = URL.createObjectURL(file);
          thumb.src = objectUrl;
          thumb.onload = () => URL.revokeObjectURL(objectUrl);
          chip.appendChild(thumb);
        }

        const name = document.createElement('span');
        name.className = 'attachment-chip-name';
        name.textContent = file.name;

        const size = document.createElement('span');
        size.className = 'attachment-chip-size';
        size.textContent = formatFileSize(file.size);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'attachment-chip-remove';
        remove.textContent = '\u00d7';
        remove.setAttribute('aria-label', 'Remove ' + file.name);
        remove.addEventListener('click', () => removeAttachment(index));

        chip.append(name, size, remove);
        attachmentPreview.appendChild(chip);
      });

      if (files.length > 1) {
        const clearAll = document.createElement('button');
        clearAll.type = 'button';
        clearAll.className = 'attachment-clear-all';
        clearAll.textContent = 'Clear all';
        clearAll.addEventListener('click', clearAttachments);
        attachmentPreview.appendChild(clearAll);
      }

      attachmentPreview.classList.add('is-visible');
    }

    attachmentInput.addEventListener('change', () => {
      clearChatError();
      renderAttachmentPreview();
    });

    // open a shared photo at full size in a new tab
    messageContainer.addEventListener('click', (event) => {
      const image = event.target.closest('.attachments img');
      if (image) {
        window.open(image.src, '_blank', 'noopener');
      }
    });



    // renders the placeholder shown when a conversation has no messages.
    // it rebuilds the element every time, so it never depends on a node that
    // a previous render may have removed from the DOM.
    function renderEmptyState(text) {
      const empty = document.createElement('div');
      empty.className = 'nothing';
      empty.id = 'empty-chatbox';

      const icon = document.createElement('img');
      icon.src = '/images/illustration.png';
      icon.alt = '';

      const message = document.createElement('p');
      message.textContent = text;

      const hint = document.createElement('small');
      hint.textContent = 'Send the first message to get started.';

      empty.append(icon, message, hint);
      messageContainer.replaceChildren(empty);
    }

    function buildMessageHTML(message) {
      const isMine = String(message.sender.id) === loggedinUserId;
      const messageClass = isMine ? 'you-message' : 'other-message';
      const senderName = escapeHtml(message.sender.name);
      const senderAvatar = message.sender.avatar
        ? `/uploads/avatars/${escapeHtml(message.sender.avatar)}`
        : '/images/nophoto.png';
      const showAvatar = isMine
        ? ''
        : `<img src="${senderAvatar}" alt="${senderName}" />`;

      let attachments = '<div class="attachments">';

      if (message.attachment && message.attachment.length > 0) {
        message.attachment.forEach((item) => {
          attachments += `<img src="/uploads/attachments/${escapeHtml(item)}" alt="Attachment" loading="lazy" />`;
        });
      }
      attachments += '</div>';

      return `<div class="message-row ${messageClass}">
        <div class="message-content">
          ${showAvatar}
          <div class="message-body">
            <div class="message-text">${escapeHtml(message.text)}</div>
            ${attachments}
            <div class="message-time">${moment(message.date_time).fromNow()}</div>
          </div>
        </div>
      </div>`;
    }

    // incremented on every conversation switch so a slow response for an older
    // click cannot overwrite the conversation the user is looking at now
    let messagesRequestId = 0;

    async function getMessages(conversationId, partnerName, rowElement) {
      const messagesFailureToast = Toastify({
        text: 'Could not load the conversation',
        duration: 1800,
      });

      const requestId = ++messagesRequestId;

      try {
        const res = await fetch(`/inbox/messages/${conversationId}`);
        const result = await res.json();

        // a newer conversation was selected while this request was in flight
        if (requestId !== messagesRequestId) {
          return;
        }

        if (result.errors || !result.data) {
          messagesFailureToast.showToast();
          return;
        }

        const { data } = result;

        participant = data.participant;
        current_conversation_id = conversationId;
        chatTitleContainer.textContent = partnerName;
        chatStatus.textContent = 'Private conversation';
        chatPartnerAvatar.src = participant?.avatar
          ? `/uploads/avatars/${participant.avatar}`
          : '/images/nophoto.png';
        chatPartnerAvatar.alt = partnerName;
        form.style.visibility = 'visible';
        deleteConversationButton.disabled = false;

        conversationList.querySelectorAll('.conversation').forEach((row) => {
          row.classList.toggle('active', row === rowElement);
        });

        // on narrow screens this reveals the chat pane
        chatContainer.classList.add('chat-open');

        const messages = Array.isArray(data.messages) ? data.messages : [];

        if (messages.length === 0) {
          renderEmptyState(`Say hi to ${partnerName}`);
        } else {
          // build once instead of rewriting innerHTML for every message
          messageContainer.innerHTML = messages.map(buildMessageHTML).join('');
        }
      } catch (err) {
        if (requestId === messagesRequestId) {
          messagesFailureToast.showToast();
        }
      }
    }

    form.onsubmit= async function(event){
      event.preventDefault();

      clearChatError();

      const messageInput = form.querySelector('[name="message"]');
      const files = Array.from(attachmentInput.files);

      // nothing to send
      if (!messageInput.value.trim() && files.length === 0) {
        return;
      }

      // a conversation has to be selected first
      if (!participant || !current_conversation_id) {
        showChatError("Please select a conversation first");
        return;
      }

      // validate the selected files before uploading
      if (files.length > MAX_ATTACHMENTS) {
        showChatError("Maximum " + MAX_ATTACHMENTS + " files can be attached at a time");
        return;
      }

      const invalidType = files.find(
        (file) => !ALLOWED_ATTACHMENT_TYPES.includes(file.type),
      );
      if (invalidType) {
        showChatError(
          invalidType.name +
            ": only .jpg, .jpeg, .png, .webp or .gif images are allowed",
        );
        return;
      }

      const tooLarge = files.find((file) => file.size > MAX_ATTACHMENT_SIZE);
      if (tooLarge) {
        showChatError(
          tooLarge.name +
            " is " +
            formatFileSize(tooLarge.size) +
            " - maximum size per file is " +
            formatFileSize(MAX_ATTACHMENT_SIZE),
        );
        return;
      }

      // prepare the form data
      const formData = new FormData(form);
      formData.append('receiverId', participant.id);
      formData.append('receiverName', participant.name);
      formData.append('avatar', participant.avatar || '');
      formData.append('conversationId', current_conversation_id);

      sendButton.disabled = true;

      try {
        // send the request to server
        const response = await fetch("/inbox/message", {
          method: "POST",
          body: formData,
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result || result.errors) {
          // show the first server error, if there is one
          let errorMessage = "Could not send the message. Please try again.";
          if (result && result.errors) {
            const firstError = Object.values(result.errors)[0];
            errorMessage =
              typeof firstError === "string"
                ? firstError
                : firstError.msg || errorMessage;
          }
          showChatError(errorMessage);
          return;
        }

        // clear the form and reload the conversation so the new message shows up
        form.reset();
        renderAttachmentPreview();
        await getMessages(
          current_conversation_id,
          participant.name,
          conversationList.querySelector('.conversation.active'),
        );
      } catch (err) {
        showChatError(
          "Could not send the message. Please check your connection and try again.",
        );
      } finally {
        sendButton.disabled = false;
      }
    }

    // turn the server-rendered timestamps into "2 hours ago" style labels
    document.querySelectorAll('time[data-relative]').forEach((element) => {
      const value = new Date(element.getAttribute('datetime'));
      if (!Number.isNaN(value.getTime())) {
        element.textContent = moment(value).fromNow();
      }
    });
  </script>
  </body>
  
</html>